<?xml version="1.0" encoding="utf-8"?>
<!--
  아이콘 배경: 해질녘처럼 가라앉은 황토색 + 가장자리 비네팅.
  차분한 톤이라 파란 차체가 살고, 표정도 조금 서늘하게 읽힌다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#D8C08C" />
                <item android:offset="1" android:color="#8A6E44" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 가장자리를 어둡게 눌러 깊이를 준다 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="62"
                android:type="radial">
                <item android:offset="0.45" android:color="#00000000" />
                <item android:offset="1" android:color="#66000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
