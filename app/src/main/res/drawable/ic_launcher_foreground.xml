<?xml version="1.0" encoding="utf-8"?>
<!--
  얼굴 달린 만화 기차 (오리지널 캐릭터).
  큰 원형 눈 + 커다란 검은 눈동자 + 두꺼운 각진 눈썹으로 살짝 서늘한 표정을 준다.
  108x108 뷰포트에서 중앙 72dp 안전영역(18~90) 안에 모든 요소를 배치했다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 굴뚝 -->
    <path
        android:pathData="M46,28.5 h16 l-2.5,10 h-11 z"
        android:fillColor="#22282D" />
    <path
        android:pathData="M42.5,23 h23 v5.5 h-23 z"
        android:fillColor="#161B1F" />

    <!-- 차체 (테두리 + 본체) -->
    <path
        android:pathData="M54,35 a22,22 0 1 0 0,44 a22,22 0 1 0 0,-44 z"
        android:fillColor="#0D3A6B" />
    <path
        android:pathData="M54,36 a21,21 0 1 0 0,42 a21,21 0 1 0 0,-42 z"
        android:fillColor="#1B5FA8" />

    <!-- 전조등 (어둑한 황색) -->
    <path
        android:pathData="M54,36 a3.2,3.2 0 1 0 0,6.4 a3.2,3.2 0 1 0 0,-6.4 z"
        android:fillColor="#DCB147" />

    <!-- 얼굴 -->
    <path
        android:pathData="M54,42 a16,16 0 1 0 0,32 a16,16 0 1 0 0,-32 z"
        android:fillColor="#E3DCCB" />

    <!-- 눈 (크고 동그랗게) -->
    <path
        android:pathData="M46.5,49.6 a6.4,6.4 0 1 0 0,12.8 a6.4,6.4 0 1 0 0,-12.8 z"
        android:fillColor="#FBF8F1" />
    <path
        android:pathData="M61.5,49.6 a6.4,6.4 0 1 0 0,12.8 a6.4,6.4 0 1 0 0,-12.8 z"
        android:fillColor="#FBF8F1" />

    <!-- 눈동자 (크고 새까맣게 — 반사광 없이) -->
    <path
        android:pathData="M46.5,51.6 a4.4,4.4 0 1 0 0,8.8 a4.4,4.4 0 1 0 0,-8.8 z"
        android:fillColor="#0A0A0A" />
    <path
        android:pathData="M61.5,51.6 a4.4,4.4 0 1 0 0,8.8 a4.4,4.4 0 1 0 0,-8.8 z"
        android:fillColor="#0A0A0A" />

    <!-- 눈썹 (안쪽이 내려간 각도로 서늘하게) -->
    <path
        android:pathData="M40.5,45.4 q6.2,0.4 11,3.2"
        android:strokeColor="#14181C"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M67.5,45.4 q-6.2,0.4 -11,3.2"
        android:strokeColor="#14181C"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />

    <!-- 입 (얕게 웃는 곡선) -->
    <path
        android:pathData="M47.5,67 q6.5,5 13,0"
        android:strokeColor="#2A1F19"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- 하부 프레임 -->
    <path
        android:pathData="M35,73 h38 v6.5 h-38 z"
        android:fillColor="#97302B" />

    <!-- 바퀴 -->
    <path
        android:pathData="M44,77.5 a4.6,4.6 0 1 0 0,9.2 a4.6,4.6 0 1 0 0,-9.2 z"
        android:fillColor="#1B2126" />
    <path
        android:pathData="M64,77.5 a4.6,4.6 0 1 0 0,9.2 a4.6,4.6 0 1 0 0,-9.2 z"
        android:fillColor="#1B2126" />
    <path
        android:pathData="M44,80.4 a1.7,1.7 0 1 0 0,3.4 a1.7,1.7 0 1 0 0,-3.4 z"
        android:fillColor="#8B9AA5" />
